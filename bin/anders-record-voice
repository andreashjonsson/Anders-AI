#!/usr/bin/env bash
# Record your own voice as Anders' speaking voice (Chatterbox voice cloning).
# Saves ~/.openjarvis/voices/reference.wav, which the `anders` launcher uses automatically.
set -euo pipefail
OJ="$HOME/.openjarvis"
REF="$OJ/voices/reference.wav"
mkdir -p "$OJ/voices"

if curl -sf http://127.0.0.1:8765/health >/dev/null 2>&1; then
    echo "Anders körs just nu (röstservern använder grafikkortet). Stäng Anders först och kör sedan detta igen."
    exit 1
fi

cat <<'EOF'

=== Spela in din röst för Anders ===

Tips för bäst resultat:
  * Sitt i ett tyst rum (stäng av fläktar, musik, TV).
  * Ha mikrofonen 20–30 cm från munnen.
  * Läs i lugnt, naturligt tempo – så som du vill att Anders ska låta.

Läs den här texten högt när inspelningen startar:

  "Hej! Jag heter Anders och jag är din personliga assistent här hemma.
   Jag kan hjälpa dig att tända lamporna, kolla vädret och hålla koll på
   kalendern. Säg bara till om det är något du behöver, så fixar jag det."

Inspelningen stoppar automatiskt när du har varit tyst i två sekunder.
EOF
read -rp $'\nTryck Enter när du är redo… ' _

if [[ -f "$REF" ]]; then cp -f "$REF" "$REF.bak"; fi
"$OJ/.venv/bin/python" -I - "$REF" <<'PYEOF'
import os, sys, time, numpy as np, sounddevice as sd, soundfile as sf
sys.path.insert(0, os.path.expanduser("~/.openjarvis/plugins"))
out = sys.argv[1]
SR = 48000
for n in (3, 2, 1):
    print(f"  {n}…", flush=True); time.sleep(0.8)
print("  ● SPELAR IN – läs texten nu!", flush=True)

from faster_whisper.vad import get_vad_model
vad = get_vad_model()
frames, speech_seen, quiet, prev = [], False, 0, np.zeros(512, dtype="float32")
block = 3072  # 64 ms at 48 kHz -> 1024 samples at 16 kHz
with sd.InputStream(samplerate=SR, channels=1, dtype="float32", blocksize=block) as st:
    for i in range(int(40 * SR / block)):  # 40 s max
        x, _ = st.read(block); x = x[:, 0].copy(); frames.append(x)
        x16 = x.reshape(-1, 3).mean(axis=1)
        p = float(np.asarray(vad(np.concatenate([prev[-1024:] if prev.size >= 1024 else np.zeros(1024, 'float32'), x16]))).reshape(-1)[-2:].max())
        prev = x16
        if p > 0.5: speech_seen, quiet = True, 0
        elif speech_seen: quiet += 1
        if speech_seen and quiet * block / SR >= 2.0: break
        if not speech_seen and i * block / SR > 10: break
audio = np.concatenate(frames)
print("  ■ Klart.\n")

# Trim silence (keep 0.3 s padding), measure quality, normalise.
env = np.sqrt(np.convolve(audio**2, np.ones(2400) / 2400, mode="same"))
noise = np.percentile(env, 10)
voiced = np.where(env > max(noise * 4, 0.01))[0]
if voiced.size == 0:
    print("Hörde ingen röst. Kontrollera mikrofonen och försök igen."); sys.exit(2)
a, b = max(0, voiced[0] - int(0.3 * SR)), min(audio.size, voiced[-1] + int(0.3 * SR))
audio = audio[a:b]
dur = audio.size / SR
clip = float((np.abs(audio) > 0.98).mean() * 100)
speech_level = np.percentile(env[a:b], 90)
snr = 20 * np.log10(max(speech_level, 1e-6) / max(noise, 1e-6))
audio = audio / max(np.abs(audio).max(), 1e-6) * 0.89  # -1 dBFS
sf.write(out, audio, SR, subtype="PCM_16")

print(f"  Längd: {dur:.1f} s   Signal/brus: {snr:.0f} dB   Överstyrning: {clip:.2f} %")
problems = []
if dur < 8: problems.append("för kort – läs hela texten (minst ~10 s)")
if snr < 20: problems.append("mycket bakgrundsbrus – prova ett tystare rum eller närmare mikrofonen")
if clip > 0.1: problems.append("överstyrt – sänk mikrofonvolymen i Inställningar → Ljud → Ingång")
if problems:
    print("  ⚠ " + "\n  ⚠ ".join(problems))
else:
    print("  ✓ Inspelningen ser bra ut.")
PYEOF
rc=$?
[[ $rc -ne 0 ]] && exit $rc

echo; echo "Spelar upp din inspelning…"
"$OJ/.venv/bin/python" -I -c "import sounddevice as sd, soundfile as sf; d,sr=sf.read('$REF'); sd.play(d,sr); sd.wait()"

echo; echo "Skapar Anders röst från din inspelning (tar ~30 s)…"
"$OJ/chatterbox/.venv/bin/python" -I - "$REF" <<'PYEOF' 2>/dev/null
import sys, warnings; warnings.filterwarnings("ignore")
import sounddevice as sd, torch
from chatterbox.mtl_tts import ChatterboxMultilingualTTS
m = ChatterboxMultilingualTTS.from_pretrained(device="cuda" if torch.cuda.is_available() else "cpu")
m.prepare_conditionals(sys.argv[1])
for lang, text in [("sv", "Hej Andreas! Det här är min nya röst. Jag har tänt lamporna i köket åt dig."),
                   ("en", "Hello Andreas! This is my new voice. I've turned on the kitchen lights for you.")]:
    wav = m.generate(text, language_id=lang)
    print(f"  ▶ {lang}", flush=True)
    sd.play(wav.squeeze(0).cpu().numpy(), m.sr); sd.wait()
PYEOF

cat <<EOF

Klart! Rösten är sparad i: $REF
Anders använder den automatiskt nästa gång du startar Anders.
  * Inte nöjd? Kör 'anders-record-voice' igen (förra inspelningen sparas som reference.wav.bak).
  * Tillbaka till standardrösten: ta bort $REF
EOF
